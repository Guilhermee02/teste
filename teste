    if CFG.gen then pcall(drawGens, camPos) end
    if CFG.trap then pcall(drawTraps, camPos) end
end)

-- Tasks em background para atualização de dados
task.spawn(function()
    while running do
        pcall(function()
            local map = Workspace:FindFirstChild("Map")
            if map then
                genList = collectGens()
                ensureSlots(genPool, math.min(#genList, CFG.genPool), CFG.genThick, CFG.genText)
            end
        end)
        task.wait(2)
    end
end)

task.spawn(function()
    while running do
        pcall(function()
            trapList = collectTraps()
            ensureSlots(trapPool, math.min(#trapList, CFG.trapPool), CFG.trapThick, CFG.trapText)
        end)
        task.wait(1)
    end
end)

task.spawn(function()
    while running do
        pcall(scStep)
        task.wait(1 / CFG.scHz)
    end
    scReleaseInput()
end)

local API = {}
_G.__SWANGY = API

function API.unload()
    if not running then return end
    running = false
    scReleaseInput()
    if connection then connection:Disconnect(); connection = nil end
    for i = 1, #genPool do removeSlot(genPool[i]) end
    for i = 1, #trapPool do removeSlot(trapPool[i]) end
    genPool, trapPool = {}, {}
    if _G.__SWANGY == API then _G.__SWANGY = nil end
end
API.stop = API.unload

return API
